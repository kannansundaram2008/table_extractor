{
  "training_data_config": {
    "version": "1.0",
    "description": "Configuration for FIR document training data collection system",
    "created_at": "2025-10-21T00:24:52.489Z",
    "data_collection": {
      "auto_save": true,
      "quality_threshold": 0.8,
      "buffer_size": 1000,
      "auto_flush_interval": 300,
      "enable_data_collection": true
    },
    "annotation": {
      "auto_create_tasks": true,
      "default_priority": 5,
      "estimated_time_per_task": 15,
      "web_interface_enabled": true,
      "web_interface_port": 8080
    },
    "storage": {
      "base_path": "models/training_data",
      "raw_examples_path": "raw_examples",
      "annotations_path": "annotations",
      "models_path": "models",
      "exports_path": "exports",
      "logs_path": "logs"
    },
    "data_formats": {
      "supported_export_formats": ["json", "jsonl", "csv"],
      "default_export_format": "json",
      "include_confidence_scores": true,
      "include_metadata": true
    },
    "privacy": {
      "enable_anonymization": true,
      "pii_fields": ["complainant_name", "victim_name", "accused_name", "complainant_address", "victim_address", "accused_address"],
      "anonymization_method": "hash",
      "retain_structure": true
    },
    "validation": {
      "enable_quality_checks": true,
      "min_quality_score": 0.0,
      "max_quality_score": 1.0,
      "validate_field_consistency": true,
      "validate_date_formats": true
    },
    "model_training": {
      "supported_model_types": ["ner", "classification", "extraction"],
      "default_model_type": "extraction",
      "train_test_split": 0.8,
      "validation_split": 0.1,
      "random_seed": 42
    }
  }
}